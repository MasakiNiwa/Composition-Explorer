{
  "name": "composition-explorer",
  "private": true,
  "version": "0.4.0",
  "description": "Discover unseen compositions with math and art theory.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "npm run licenses && vite",
    "build": "npm run licenses:check && tsc -b && vite build",
